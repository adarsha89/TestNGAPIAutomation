# Copy to .env in this same directory to override any default.
# .env itself is gitignored — never commit real credentials here even
# though these are local-dev-only defaults out of the box.

# --- Elasticsearch ---
ELASTICSEARCH_VERSION=8.15.3
ES_HTTP_PORT=9200
ES_TRANSPORT_PORT=9300
ES_HEAP=1g

# --- SonarQube ---
SONARQUBE_VERSION=26.8.0.126808-community
SONARQUBE_PORT=9000
POSTGRES_VERSION=15
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonar

# --- Grafana ---
GRAFANA_VERSION=11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Jenkins ---
JENKINS_VERSION=lts-jdk17
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
